# Beszel — segredos gerados pelo hub (NÃO versionar este arquivo .env)
# KEY  = chave pública SSH do hub (identidade que o hub usa para conectar no agente)
# TOKEN = token do sistema (definido também em beszel_data/config.yml)
BESZEL_KEY=
BESZEL_TOKEN=

# Observação: os sistemas monitorados são declarados em
# network/monitoring/beszel/beszel_data/config.yml (lido no startup do hub).
# O token acima deve ser o mesmo token declarado naquele config.yml.
