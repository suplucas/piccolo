# Senha do admin do Grafana (usuário: admin). NÃO comitar o .env real.
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Portas HTTP/gRPC que o Beyla vai instrumentar (lista CSV). Ajuste conforme
# os serviços que você expõe. 80/443 pegam tudo que passa pelo Caddy.
BEYLA_OPEN_PORT=80,443,2283,3000,5055,7878,8080,8081,8082,8090,8096,9696

# API key do Jellyfin (Dashboard > API Keys) usada pelo jellyfin-exporter.
JELLYFIN_TOKEN=cole-aqui-a-api-key-do-jellyfin
